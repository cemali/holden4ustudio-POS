# Keep the Docker build context small and free of secrets/local data.
node_modules
npm-debug.log*
*.log

# Local NeDB data - never bake data into the image
databases

# Git and CI metadata
.git
.gitignore
.github

# Secrets / local config
.env
.env.*
.npmrc

# Docker files themselves
Dockerfile
.dockerignore

# Editor / OS clutter
.vscode
.idea
.DS_Store
Thumbs.db

# Text files
*.txt

